# Supabase credentials — copy this file to .env.local and fill in values
# Full guide: docs/API_KEYS.md  |  In-app: Settings → Setup audit
# Project Settings → API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — service_role key (NOT the anon key). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public app URL — used for invite links and auth redirects
# Preview: set to your Vercel preview URL (see docs/PREVIEW_ENV_PARITY.md)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe commercial packaging (T9) — use test-mode keys until founder enables live mode.
# Server-only secret; NEVER prefix with NEXT_PUBLIC.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRICE_EXPERIENCE=price_...
# STRIPE_PRICE_LAUNCHPAD=price_...
# STRIPE_PRICE_PROFESSIONAL=price_...
# Turn on only after migration 0097 + webhook + prices are configured and tested.
# DELIVERX_BILLING_ENFORCE=off

# Server-only — signs project invite JWT links (7-day expiry).
# Required explicitly on Vercel Production/Preview. Local dev may fall back to CRON_SECRET.
INVITE_JWT_SECRET=any-random-string-you-make-up

# Vercel Analytics + Speed Insights — off locally; production deploys load automatically.
# Set true on Preview only when you want metrics on a preview deployment.
# NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=true

# OpenAI — primary AI provider (assistant, reviews, structure, Whisper, embeddings)
OPENAI_API_KEY=sk-your-openai-key
# Optional model override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional fallbacks — not needed if using OpenAI only
# MINIMAX_API_KEY=your-minimax-api-key
# MINIMAX_MODEL=MiniMax-M2.7
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Vercel cron — NOT needed for local dev. Add in Vercel dashboard for production twin snapshots.
CRON_SECRET=any-random-string-you-make-up

# Recall.ai — meeting bot + transcript sync (Sprint G3)
# RECALL_API_KEY=your-recall-api-key
# RECALL_REGION=us-east-1
# RECALL_WEBHOOK_SECRET=your-workspace-verification-secret

# Report publish emails (optional — publish still works without email)
# Project invite emails (optional — link copy still works without email)
# RESEND_API_KEY=re_your-resend-key
# EMAIL_FROM=DeliverX <reports@yourdomain.com>
