# Supabase credentials — copy this file to .env.local and fill in values
# Project Settings → API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — used for admin actions. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vercel cron auth — set the same value in Vercel env vars for /api/twin/snapshot
# Hobby plan: cron schedules in vercel.json must run at most once per day (currently 06:00 UTC).
CRON_SECRET=generate-a-random-secret-for-vercel-cron
