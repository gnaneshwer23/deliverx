# Supabase credentials — copy this file to .env.local and fill in values
# Project Settings → API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — service_role key (NOT the anon key). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public app URL — used for invite links and auth redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MiniMax — server-only (Anthropic-compatible API). Never expose to the browser.
# Get key: https://platform.minimax.io/user-center/basic-information/interface-key
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_MODEL=MiniMax-M2.7
# Optional — defaults to https://api.minimax.io/anthropic
# MINIMAX_BASE_URL=https://api.minimax.io/anthropic

# OpenAI — server-only (Whisper transcription + charter embeddings). Optional for Phase B.
# Use a real OpenAI key here — not your MiniMax key.
OPENAI_API_KEY=sk-your-openai-key-here

# Vercel cron auth — only needed when deployed to Vercel (skip for local dev)
# Hobby plan: cron schedules in vercel.json must run at most once per day (currently 06:00 UTC).
# CRON_SECRET=generate-a-random-secret-for-vercel-cron
