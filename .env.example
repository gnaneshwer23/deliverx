# Supabase credentials — copy this file to .env.local and fill in values
# Full guide: docs/API_KEYS.md  |  In-app: Settings → Integrations
# Project Settings → API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — service_role key (NOT the anon key). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public app URL — used for invite links and auth redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MiniMax — server-only (Anthropic-compatible API). Never expose to the browser.
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_MODEL=MiniMax-M2.7

# Anthropic — alternative text AI provider (used if MINIMAX_API_KEY is unset)
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI — optional (Whisper transcription + charter embeddings only)
# OPENAI_API_KEY=sk-your-openai-key

# Vercel cron — NOT needed for local dev. Add in Vercel dashboard for production twin snapshots.
CRON_SECRET=any-random-string-you-make-up
